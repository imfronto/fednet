TZ=America/New_York
PUID=1000
PGID=1000
# GID of the host's `docker` group (run `getent group docker | cut -d: -f3`
# to find yours) — lets Homepage's live container-stats widget read
# /var/run/docker.sock without running as root.
DOCKER_GID=999
# Full Tailscale MagicDNS name, e.g. fednet.tailnet-name.ts.net
TAILSCALE_HOSTNAME=fednet
# Pi-hole admin password (required, no default)
PIHOLE_PASSWORD=changeme
# Grafana admin password (required, no default)
GRAFANA_ADMIN_PASSWORD=changeme
# Webhook URL the gravity-watchdog alert posts to (Discord/Slack incoming webhook)
GRAVITY_WEBHOOK_URL=changeme
GRAVITY_MAX_AGE_HOURS=48
# Port BambuBuddy's web UI listens on (host networking, so this must not
# collide with any other host port)
BAMBUDDY_PORT=8000
# Portainer API access token for Homepage's live container-count widget.
# Generate one in Portainer: user icon -> My Account -> Access Tokens ->
# Add access token. Leave unset to just skip that one widget.
PORTAINER_API_KEY=

# Backups (restic) — see README "Backups" section
# Any restic-supported repository: a local path, sftp:user@host:/path,
# an S3-compatible bucket, or Backblaze B2 (b2:bucketname:path)
BACKUP_RESTIC_REPOSITORY=/home/fronto/backups/fednet-restic
# Encrypts and authenticates the repo — restic cannot recover a lost
# password, so store this somewhere outside the repo too (password manager)
BACKUP_RESTIC_PASSWORD=changeme
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
# Optional — where backup.sh alerts on failure (Discord/Slack incoming
# webhook). Falls back to GRAVITY_WEBHOOK_URL if unset, so leave this out
# entirely to reuse that one, or set it to alert somewhere else instead.
# BACKUP_WEBHOOK_URL=changeme

# Optional — where the honeypot alerts on a probe (Discord/Slack incoming
# webhook). Falls back to GRAVITY_WEBHOOK_URL if unset. See README
# "Honeypot" section.
# HONEYPOT_WEBHOOK_URL=changeme
# Optional — burst detection tuning (defaults: 10 probes / 60s window /
# 300s cooldown between burst alerts). A burst fires a separate, more
# urgent alert on top of the normal per-probe ones, not instead of them.
# HONEYPOT_BURST_THRESHOLD=10
# HONEYPOT_BURST_WINDOW_SECONDS=60
# HONEYPOT_BURST_COOLDOWN_SECONDS=300

# Optional — DNS flood detection (Pi-hole). Alerts if one LAN device
# floods DNS queries (a common symptom of a compromised/infected
# device) or the whole network's query rate spikes. Falls back to
# GRAVITY_WEBHOOK_URL if unset. Defaults: 300 queries/min from a single
# client, 2000/min network-wide, 300s cooldown between alerts — tune
# these to your actual household's normal traffic if you get false
# positives/negatives.
# PIHOLE_FLOOD_WEBHOOK_URL=changeme
# PIHOLE_CLIENT_FLOOD_THRESHOLD=300
# PIHOLE_TOTAL_FLOOD_THRESHOLD=2000
# PIHOLE_FLOOD_COOLDOWN_SECONDS=300

TZ=America/New_York
PUID=1000
PGID=1000
# Full Tailscale MagicDNS name, e.g. fednet.tailnet-name.ts.net
TAILSCALE_HOSTNAME=fednet
# Pi-hole admin password (required, no default)
PIHOLE_PASSWORD=changeme
# Grafana admin password (required, no default)
GRAFANA_ADMIN_PASSWORD=changeme
# Webhook URL the gravity-watchdog alert posts to (Discord/Slack incoming webhook)
GRAVITY_WEBHOOK_URL=changeme
GRAVITY_MAX_AGE_HOURS=48

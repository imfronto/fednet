# pihole-guardian configuration reference.
#
# When run via this repo's docker-compose (services/pihole-guardian.yml),
# these variables are read from the ROOT .env file, not this file — this
# copy exists as a complete, documented reference and for running the
# service standalone (outside Docker) during development.
#
# Every variable is prefixed GUARDIAN_ except where it deliberately reuses
# a variable already defined for the `pihole` service itself.

# ---- Pi-hole integration ----
GUARDIAN_PIHOLE_URL=http://pihole:80
# Reuse the same admin password Pi-hole itself already requires — do not
# duplicate the secret in two places. In docker-compose this is wired as
# GUARDIAN_PIHOLE_PASSWORD=${PIHOLE_PASSWORD}.
GUARDIAN_PIHOLE_PASSWORD=changeme
GUARDIAN_PIHOLE_TLS_VERIFY=true
GUARDIAN_PIHOLE_TIMEOUT_SECONDS=10

# ---- Operating mode ----
# AUDIT (default, safest) -> DRY_RUN -> RECOMMEND -> ENFORCE.
# Do not jump straight to ENFORCE on a new deployment — see
# docs/CONFIGURATION.md for the recommended rollout sequence.
GUARDIAN_MODE=AUDIT

# ---- Scheduling ----
GUARDIAN_POLL_INTERVAL_SECONDS=300
GUARDIAN_CLASSIFY_INTERVAL_SECONDS=600
GUARDIAN_DECIDE_INTERVAL_SECONDS=900
GUARDIAN_REVALIDATION_INTERVAL_HOURS=72
GUARDIAN_DISRUPTION_CHECK_INTERVAL_SECONDS=120
GUARDIAN_LIST_REFRESH_INTERVAL_HOURS=24
GUARDIAN_RETENTION_DAYS_OBSERVATIONS=180
GUARDIAN_RETENTION_DAYS_CHANGES=730
GUARDIAN_RETENTION_HOURS_RECENT_BUCKETS=72
GUARDIAN_RECENT_BUCKET_MINUTES=5

# ---- Decision thresholds ----
# These four are jointly calibrated — see the comment above them in
# src/pihole_guardian/config.py before changing just one.
GUARDIAN_BLOCK_CONFIDENCE_THRESHOLD=0.90
GUARDIAN_MONITOR_CONFIDENCE_THRESHOLD=0.40
GUARDIAN_MIN_INDEPENDENT_SOURCES_FOR_BLOCK=2
GUARDIAN_MAX_SINGLE_SOURCE_WEIGHT=0.45
GUARDIAN_SOURCE_AGREEMENT_BONUS=0.20
GUARDIAN_CONFLICT_PENALTY=0.30

# ---- Disruption detection ----
GUARDIAN_DISRUPTION_QUERY_RATE_SPIKE_MULTIPLIER=3.0
GUARDIAN_DISRUPTION_SIBLING_FAILURE_RATE_THRESHOLD=0.5
GUARDIAN_DISRUPTION_MIN_QUERIES=5
GUARDIAN_DISRUPTION_LOOKBACK_HOURS=1

# ---- Reputation providers ----
GUARDIAN_URLHAUS_ENABLED=true
GUARDIAN_RDAP_ENABLED=true
GUARDIAN_TRACKER_LIST_ENABLED=true
GUARDIAN_TRACKER_LIST_URLS=https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts
# Optional. Leave empty to disable VirusTotal lookups entirely (default).
GUARDIAN_VIRUSTOTAL_API_KEY=
GUARDIAN_REPUTATION_PROVIDER_TIMEOUT_SECONDS=8

# ---- Privacy ----
# Off by default. If enabled, GUARDIAN_CLIENT_HASH_SALT is required — pick
# a random value and never reuse it across deployments (it is used only to
# make the stored per-domain client hash unlinkable without it).
GUARDIAN_CLIENT_TRACKING_ENABLED=false
GUARDIAN_CLIENT_HASH_SALT=

# ---- Storage ----
GUARDIAN_DATABASE_PATH=/data/pihole-guardian/guardian.db
GUARDIAN_PROTECTED_DOMAINS_PATH=/data/pihole-guardian/protected_domains.yml

# ---- API / dashboard ----
GUARDIAN_API_HOST=0.0.0.0
GUARDIAN_API_PORT=8930
GUARDIAN_DASHBOARD_USERNAME=admin
# Required — no default. The service refuses to start without this set.
GUARDIAN_DASHBOARD_PASSWORD=changeme
# Required — no default. Bearer token for the JSON API and CLI-over-HTTP use.
GUARDIAN_API_TOKEN=changeme
GUARDIAN_RATE_LIMIT_PER_MINUTE=120

# ---- Logging ----
GUARDIAN_LOG_LEVEL=INFO
GUARDIAN_LOG_FORMAT=json
